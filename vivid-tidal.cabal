cabal-version:      3.0
name:               vivid-tidal
version:            0.1.0.0
synopsis:
    Send SynthDef's to scsynth via OSC messages to use it from TidalCycles

-- description:
homepage:           http://github.com/superguaricho/vivid-tidal
license:            BSD-3-Clause
license-file:       LICENSE
author:             Numa Tortolero
maintainer:         numa.tortolero@gmail.com
-- copyright:
category:           Sound
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:
common warnings
    ghc-options: -Wall

library
    exposed-modules:  Vivid.Tidal
                      Vivid.Tidal.Examples
                      Vivid.Tidal.Cymbals
    -- other-modules:
    default-extensions: DataKinds, OverloadedStrings
    -- other-extensions:
    build-depends:    base ^>=4.18.3.0,
                      tidal,
                      vivid,
                      vivid-osc,
                      network,
                      bytestring,
                      stm,
                      containers,
                      utf8-string
    hs-source-dirs:   src
    default-language: Haskell2010
