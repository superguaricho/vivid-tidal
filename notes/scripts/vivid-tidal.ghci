-- Definimos la macro :boot
:def! boot \_ -> return ":script loadme.ghci"

-- Mensaje destacado con colores ANSI y formato
:{
let green = "\ESC[1;32m"
    cyan  = "\ESC[1;36m"
    reset = "\ESC[0m"
    line  = replicate 50 '-'
    -- line  = cyan ++ replicate 60 '-' ++ reset
in do
  putStrLn ""
  putStrLn line
  -- putStrLn $ cyan ++ "| " ++ green ++ "Project loaded! Type " ++ cyan ++ ":boot" ++ green ++ " to start Vivid-Tidal." ++ cyan ++ " |" ++ reset
  putStrLn $ "| Project loaded! Type :boot to start Vivid-Tidal. |"
  putStrLn line
  putStrLn ""
:}
